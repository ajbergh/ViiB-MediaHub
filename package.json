{
  "name": "viib-mediahub",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check:raw-colors": "node scripts/check-no-raw-colors-tsx.mjs",
    "check:palette": "node scripts/check-no-tailwind-palette.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run check:palette && npm run check:raw-colors && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "buffer": "5.7.1",
    "butterchurn": "^2.6.7",
    "butterchurn-presets": "^2.4.7",
    "idb": "8.0.0",
    "lucide-react": "^0.554.0",
    "music-metadata": "11.14.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "8.3.0",
    "react-virtuoso": "4.12.3",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "8.5.25",
    "tailwindcss": "^3.4.13",
    "typescript": "~5.8.2",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  }
